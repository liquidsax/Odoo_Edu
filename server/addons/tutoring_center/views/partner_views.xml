<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 联系人简化列表：姓名 / 电话（家长）/ 学校 -->
        <record id="view_partner_tutoring_list" model="ir.ui.view">
            <field name="name">res.partner.tutoring.list</field>
            <field name="model">res.partner</field>
            <field name="priority">0</field>
            <field name="arch" type="xml">
                <list string="联系人">
                    <field name="name"/>
                    <field name="phone" string="电话（家长）"/>
                    <field name="tutoring_school" string="学校"/>
                </list>
            </field>
        </record>

        <!-- 联系人简化表单：只留姓名 / 电话（家长）/ 学校 / 关联学生 -->
        <record id="view_partner_tutoring_form" model="ir.ui.view">
            <field name="name">res.partner.tutoring.form</field>
            <field name="model">res.partner</field>
            <field name="priority">0</field>
            <field name="arch" type="xml">
                <form string="联系人">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="姓名"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="phone" string="电话（家长）"/>
                                <field name="tutoring_school"/>
                            </group>
                            <group>
                                <field name="tutoring_student_ids" widget="many2many_tags"
                                       string="关联学生" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- 联系人应用：改用简化视图，新建默认为个人 -->
        <record id="contacts.action_contacts" model="ir.actions.act_window">
            <field name="view_mode">list,form</field>
            <field name="context">{'default_is_company': False, 'default_company_type': 'person'}</field>
        </record>
        <record id="contacts.action_contacts_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="0"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_partner_tutoring_list"/>
            <field name="act_window_id" ref="contacts.action_contacts"/>
        </record>
        <record id="contacts.action_contacts_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_partner_tutoring_form"/>
            <field name="act_window_id" ref="contacts.action_contacts"/>
        </record>
    </data>
</odoo>
