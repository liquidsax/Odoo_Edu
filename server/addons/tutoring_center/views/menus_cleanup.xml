<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 恢复开关：把用户加入该组，即可重新看到被隐藏的应用菜单 -->
        <record id="group_show_hidden_apps" model="res.groups">
            <field name="name">显示全部应用菜单</field>
            <field name="comment">勾选后，后台左上角应用菜单将恢复显示：应用、讨论、项目、邮件营销、调查、员工、仪表板。</field>
        </record>

        <function model="ir.ui.menu" name="_apply_tutoring_menu_cleanup"/>
        <function model="ir.ui.view" name="_apply_tutoring_view_cleanup"/>
    </data>
</odoo>
