<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 先给升级前就有的那批补上"本人档案"标记（记录规则靠它收口可见性），
             再给缺档案的老师补一条新的。放在数据阶段而不是迁移脚本里，是因为
             **全新安装也会跑数据**——模块装完的第一分钟老师就能记自己的错题。
             两个方法都是 get-or-create，重复执行安全。 -->
        <function model="tutoring.student" name="mark_self_profiles"/>
        <function model="tutoring.student" name="ensure_teacher_profiles"/>
    </data>
</odoo>
