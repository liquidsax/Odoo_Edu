<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_tutoring" model="ir.module.category">
            <field name="name">R3ynA 学习平台</field>
            <field name="description">R3ynA 学习平台的访问权限</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_tutoring" model="res.groups.privilege">
            <field name="name">R3ynA 学习平台</field>
            <field name="description">R3ynA 学习平台的使用角色</field>
            <field name="category_id" ref="module_category_tutoring"/>
            <field name="sequence">25</field>
        </record>

        <record id="group_teacher" model="res.groups">
            <field name="name">教师</field>
            <field name="comment">R3ynA 学习平台：可维护学生、教学内容、课次、作业与考试数据</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_tutoring"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        </record>

        <!-- 门户用户：只能看到与自己（学生档案门户联系人）绑定的数据 -->
        <record id="rule_student_portal" model="ir.rule">
            <field name="name">学生档案：仅门户本人</field>
            <field name="model_id" ref="model_tutoring_student"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 内部用户之间：真实学生全体可见（老师要互相接手），但"别人给自己建的学习档案"不可见。
             每位老师都被自动发一条「我自己」，不收口的话它会成对出现在同事的学生列表、
             错题范围药丸和「记到谁」下拉里。 -->
        <record id="rule_student_internal" model="ir.rule">
            <field name="name">学生档案：别人的本人档案不可见</field>
            <field name="model_id" ref="model_tutoring_student"/>
            <field name="domain_force">['|', ('is_self_profile', '=', False),
                                         ('partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_session_portal" model="ir.rule">
            <field name="name">辅导课次：仅门户本人学生</field>
            <field name="model_id" ref="model_tutoring_session"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_homework_portal" model="ir.rule">
            <field name="name">作业：仅门户本人学生</field>
            <field name="model_id" ref="model_tutoring_homework"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_exam_portal" model="ir.rule">
            <field name="name">考试：仅门户本人学生</field>
            <field name="model_id" ref="model_tutoring_exam"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_exam_line_portal" model="ir.rule">
            <field name="name">考试明细：仅门户本人学生</field>
            <field name="model_id" ref="model_tutoring_exam_line"/>
            <field name="domain_force">[('exam_id.student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_topic_portal" model="ir.rule">
            <field name="name">教学内容：门户可读</field>
            <field name="model_id" ref="model_tutoring_topic"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_student_point_portal" model="ir.rule">
            <field name="name">学生知识点掌握：仅门户本人学生</field>
            <field name="model_id" ref="model_tutoring_student_point"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_mistake_portal" model="ir.rule">
            <field name="name">错题记录：仅门户本人学生（可新增/编辑自己的）</field>
            <field name="model_id" ref="model_tutoring_mistake"/>
            <field name="domain_force">[('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 档案收口了，档案名下的错题也要跟着收：否则同事在错题列表里仍然读得到
             另一个老师私人记的那道题，只是点不开它的档案。真实学生的错题照旧全体教师可见。 -->
        <record id="rule_mistake_internal" model="ir.rule">
            <field name="name">错题记录：别人本人档案下的不可见</field>
            <field name="model_id" ref="model_tutoring_mistake"/>
            <field name="domain_force">['|', ('student_id.is_self_profile', '=', False),
                                         ('student_id.partner_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- 智能画图的额度流水：只看得到自己发起的那些 -->
        <record id="rule_plot_ai_call_own" model="ir.rule">
            <field name="name">智能画图：仅发起人</field>
            <field name="model_id" ref="model_tutoring_plot_ai_call"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 摘要任务与额度：只看得到自己发起的那些（cron 用 sudo 跑，不受这条限制） -->
        <record id="rule_mistake_ai_job_own" model="ir.rule">
            <field name="name">AI 摘要任务：仅发起人</field>
            <field name="model_id" ref="model_tutoring_mistake_ai_job"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_workbook_portal" model="ir.rule">
            <field name="name">练习册：门户可读</field>
            <field name="model_id" ref="model_tutoring_workbook"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_workbook_file_portal" model="ir.rule">
            <!-- 教材 PDF 与练习册同类：共享教辅资料，门户只读；
                 /web/content 出图与 pdf.js 取流都走这条规则的 read 校验 -->
            <field name="name">教材文件：门户可读</field>
            <field name="model_id" ref="model_tutoring_workbook_file"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_knowledge_point_portal" model="ir.rule">
            <field name="name">知识点：门户可读</field>
            <field name="model_id" ref="model_tutoring_knowledge_point"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 知识库是"每个人自己的空间"：内部用户与门户用户都只碰得到自己那一份。
             ⚠️ 这里曾写过一句错话："委托继承的字段在 SQL 里 JOIN 出来，不受本规则影响"。
             实测相反：`tutoring.workbook.file` 虽有"门户可读"规则，学生 `search_count` 仍是 0，
             读 `content` 直接 AccessError——父表这条规则就是拦教材的那道墙。
             所以"把某本教材给学生看"必须落到下面这条共享规则上，没有旁路可走。 -->
        <record id="rule_library_item_own" model="ir.rule">
            <field name="name">知识库条目：仅本人</field>
            <field name="model_id" ref="model_tutoring_library_item"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_library_item_shared_read" model="ir.rule">
            <!-- 只放开 read：同一组里规则按"或"算，所以上面那条仍单独管着
                 write/create/unlink，被共享的人改不动、删不掉，也进不了配额。 -->
            <field name="name">知识库条目：被共享的人可读</field>
            <field name="model_id" ref="model_tutoring_library_item"/>
            <field name="domain_force">[('share_user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_library_folder_own" model="ir.rule">
            <field name="name">知识库文件夹：仅本人</field>
            <field name="model_id" ref="model_tutoring_library_folder"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- xmlid 特意留着 tag_all 这个名字：组规则之间是 OR，改名会多出一条
             旧的全可见规则，清理机制没跑干净就是标签全员互见。域已经是"仅本人"，
             标签名本身会暴露"这个人在学什么"，不再当共享字典。 -->
        <record id="rule_library_tag_all" model="ir.rule">
            <field name="name">知识库标签：仅本人</field>
            <field name="model_id" ref="model_tutoring_library_tag"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_mistake_cause_portal" model="ir.rule">
            <!-- 错因是公共字典，学生只是在下拉里挑一个，不能自己加 -->
            <field name="name">错因：门户可读</field>
            <field name="model_id" ref="model_tutoring_mistake_cause"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- 时间账本（Do1ng 同步上来的任务与计时）和知识库同一口径：每个人只碰得到自己那一份。
             它是"我这一天怎么花的"，比错题更私人，老师之间也不互见；admin 属 base.group_system，
             不受记录规则限制，需要代查时用它。
             五张表都挂同一条域：区间与想法上冗余存了 user_id，就是为了让规则不必 JOIN 到任务表。 -->
        <record id="rule_time_task_own" model="ir.rule">
            <field name="name">时间账本任务：仅本人</field>
            <field name="model_id" ref="model_tutoring_time_task"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_time_session_own" model="ir.rule">
            <field name="name">时间账本计时区间：仅本人</field>
            <field name="model_id" ref="model_tutoring_time_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_time_pool_item_own" model="ir.rule">
            <field name="name">时间账本想法池：仅本人</field>
            <field name="model_id" ref="model_tutoring_time_pool_item"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_time_device_own" model="ir.rule">
            <field name="name">时间账本设备：仅本人</field>
            <field name="model_id" ref="model_tutoring_time_device"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_time_sync_own" model="ir.rule">
            <field name="name">时间账本同步记录：仅本人</field>
            <field name="model_id" ref="model_tutoring_time_sync"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
