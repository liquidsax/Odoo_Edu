# 服务器部署用的 compose 覆盖变量示例。
# 在机器上复制为 .env 并填入强随机值（chmod 600），真实口令不要提交：
#   cp .env.example .env && chmod 600 .env
#   ODOO_DB_PASSWORD=$(openssl rand -base64 24)
#   ODOO_MASTER_PASSWORD=$(openssl rand -base64 24)
#
# 配套文件 docker-compose.override.yml 同样只在机器上保存，已在 .gitignore 中排除。

# PostgreSQL 容器内 odoo 角色的口令（5432 不映射到宿主机，仅容器网络可达）
ODOO_DB_PASSWORD=<强随机口令>

# Odoo 数据库管理器主口令（配合 --no-database-list 使用，管理页本就不对外）
ODOO_MASTER_PASSWORD=<强随机口令>
